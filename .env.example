# GITHUB_TOKEN=github_token
GOOGLE_API_KEY=google_api
COHERE_API_KEY=cohere_api
GROQ_API_KEY=groq_api
QDRANT_URL=qdrant_url
QDRANT_API_KEY=qdrant_api_key
DODO_API_KEY=dp_test_xxxxxxxxxxxxxxxxx
DODO_PRODUCT_ID=price_xxxxxxxxxxxxx
APP_URL=http://localhost:5500
DODO_BASE_URL=https://test.dodopayments.com
DATABASE_URL=postgres_neon_db_url

# Google sign-in (web): the OAuth "Web application" client ID. Public, not a
# secret. Must be the same on AWS and Render.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Same OAuth client's secret. Only the Android app's Google sign-in uses it
# (server-side). Keep it secret; never put it in frontend or mobile code.
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
